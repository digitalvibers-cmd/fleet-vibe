# Copy to .env (in this directory) for local docker compose to pick up.
# `make local` requires these values to be set.

# Laravel APP_KEY - generate with: openssl rand -base64 32 | sed 's/^/base64:/'
APP_KEY=base64:CHANGE_ME_RUN_OPENSSL_RAND

# MySQL root password (local stack allows empty, so leave blank if you want).
# docker-compose.local.yml sets MYSQL_ALLOW_EMPTY_PASSWORD=yes, so this is unused locally.
DB_PASSWORD=

# Cookie secret for customer-portal (next-iron-session).
# Generate with: openssl rand -hex 32
COOKIE_SECRET=CHANGE_ME_LOCAL_SECRET

# External service credentials - prod values, used everywhere per project policy.
# Mail is forced to MAIL_MAILER=log locally, so MAILGUN_SECRET is read but unused.
GOOGLE_MAPS_API_KEY=***REMOVED***
MAILGUN_SECRET=ask-team-for-this-secret

# WMS integration (3rd-party warehouse client → POST /v1/integrations/wms/orders).
# Leave empty to disable the endpoint. Generate token with: openssl rand -hex 32
# WMS_INTEGRATION_COMPANY_UUID = uuid of the FlyBox company row in `companies` table.
WMS_INTEGRATION_TOKEN=
WMS_INTEGRATION_COMPANY_UUID=
