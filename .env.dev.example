# Dev server (/opt/fleetvibe/.env). Owner: deploy, mode: 0600.
#
# Provisioned manually on the server. NEVER commit a filled-in copy of this file.

APP_KEY=base64:CHANGE_ME_RUN_OPENSSL_RAND
DB_PASSWORD=CHANGE_ME_GENERATE_HEX_32
COOKIE_SECRET=CHANGE_ME_GENERATE_HEX_32

# Shared with prod - same external services for both environments per project policy.
# Backend/server-side key: IP-restricted to the server IP, Geocoding API. PHP geocoding only.
GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_KEY
# Browser/client-side key: HTTP-referrer restricted, Maps JavaScript + Places API.
# Baked into console + customer-portal bundles at build time. NEVER hardcode in the repo.
GOOGLE_MAPS_BROWSER_KEY=CHANGE_ME_GOOGLE_MAPS_BROWSER_KEY
MAILGUN_SECRET=CHANGE_ME_MAILGUN_KEY

# WMS integration (3rd-party warehouse client → POST /v1/integrations/wms/orders).
# Leave empty to disable the endpoint. Generate token with: openssl rand -hex 32
# WMS_INTEGRATION_COMPANY_UUID = uuid of the FlyBox company row in `companies` table.
WMS_INTEGRATION_TOKEN=
WMS_INTEGRATION_COMPANY_UUID=
