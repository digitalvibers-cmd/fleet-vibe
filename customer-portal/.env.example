# Fleetbase API URL (internal Docker network for server-side BFF calls)
FLEETBASE_API_URL=http://httpd:80

# Public URL of this portal (for redirects, cookies)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Cookie encryption secret (generate with: openssl rand -base64 32)
COOKIE_SECRET=change-me-to-random-secret

# Google Maps JavaScript API key (required for pickup/dropoff address autocomplete)
# Enable: Maps JavaScript API + Places API in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
