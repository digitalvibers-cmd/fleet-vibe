<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="px-4 text-gray-900 dark:text-gray-50">
        <div class="mb-1 text-base font-semibold">
            You are about to reset the password for
            {{this.customer.name}}
        </div>
        <div class="text-sm mb-4">
            A new password will be generated and emailed to
            <span class="font-semibold">{{this.customer.email}}</span>
            for customer portal access. The customer's current portal session will be signed out.
        </div>
    </div>
</Modal::Default>